              "key": "quantity",
              "value": "{{quantity}}",
              "type": "text",
              "uuid": "610e5d5e-c7d8-4bce-9e84-852d2b503087"
            }
          ]
        },
        "url": {
          "raw": "{{baseURL}}api/cart/add",
          "host": [
            "{{baseURL}}api"
          ],
          "path": [
            "cart",
            "add"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Cart content",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// checking if cart id is present in response\r",
              "pm.test(\"Cart ID is present\", function () {\r",
              "    pm.expect(pm.response.json().products[0].cart_id).to.not.be.null;\r",
              "})\r",
              "\r",
              "// capturing cart id for further use in other requests\r",
              "pm.collectionVariables.set(\"cart_id\", pm.response.json().products[0].cart_id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
