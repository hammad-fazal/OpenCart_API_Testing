    {
      "name": "Create Session/Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// capturing json data\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "\r",
              "// checking if the api_token is present\r",
              "pm.test(\"success message is correct\", ()=> {\r",
              "    pm.expect(jsonData.success).to.eql(\"Success: API session successfully started!\");\r",
              "})\r",
              "\r",
              "pm.collectionVariables.set(\"api_token\", jsonData.api_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// setting initial collectionVariables\r",
              "pm.collectionVariables.set(\"ip\", \"192.168.0.110\");\r",
              "pm.collectionVariables.set(\"baseURL\", \"http://{{ip}}/opencart/upload/index.php?route=\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
