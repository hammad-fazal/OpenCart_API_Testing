    {
      "name": "Add product to cart",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"product_id\", \"40\");\r",
              "pm.collectionVariables.set(\"quantity\", \"2\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// verifying addition of products in cart_id\r",
              "pm.test(\"Success message is present of product addition\", function () {\r",
              "    pm.expect(pm.response.json().success).to.eql(\"Success: You have modified your shopping cart!\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "in",
              "value": "query",
              "type": "string"
            },
            {
              "key": "value",
              "value": "{{api_token}}",
              "type": "string"
            },
            {
              "key": "key",
              "value": "api_token",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "product_id",
